# Canonical list of every environment variable Vertex reads.
# Copy the web values into web/.env.local and the studio values into studio/.env.
# Never commit real values.

# --- web/.env.local ---------------------------------------------------------

# Clerk (authentication). The publishable key is browser-safe; the secret key
# is server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity (content). Project id and dataset are public; the read token is not.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-02

# Viewer token for the private dataset. Server-only — read through
# web/sanity/lib/token.ts, never exposed to the browser.
SANITY_API_READ_TOKEN=

# Write token for learner progress. Server-only, and used by exactly one caller:
# web/app/api/progress/route.ts. The browser never writes content or progress.
# Needs Editor permissions on the dataset — the read token above cannot write.
SANITY_API_WRITE_TOKEN=

# Sanity Context MCP (intelligent search). Server-only: this is the search
# agent's read path into the dataset and is authenticated with the read token
# above. The document form applies the search config imported from
# studio/context; the base form (no trailing slug) takes the same filter and
# instructions as ?groqFilter= and ?instructions= query params.
# https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/<slug>
SANITY_CONTEXT_MCP_URL=

# Google Gemini API (the search agent's model), called directly. Server-only —
# never prefixed NEXT_PUBLIC_. The browser never calls the model; it only ever
# POSTs to /api/search. Create a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash. Ids are bare (gemini-3.5-flash), not
# google/... or models/.... The model must call the Context MCP's tools on its
# own, and be fast: the route fits twelve calls inside a 90s deadline, so prefer
# a Flash model over Pro. gemini-3.8-flash calls tools but takes about a minute
# per call, so every search times out. To list what your key can use (PowerShell):
#   curl.exe -s -H "x-goog-api-key: <key>" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=

# PostHog (product analytics). The project token is public by design and is the
# only PostHog value the browser needs. Any private PostHog API key stays
# server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- studio/.env ------------------------------------------------------------

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_API_VERSION=2026-09-02
