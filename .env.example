# Canonical list of every environment variable Vertex reads.
# Copy the web values into web/.env.local and the studio values into studio/.env.
# Never commit real values.

# --- web/.env.local ---------------------------------------------------------

# Clerk (authentication). The publishable key is browser-safe; the secret key
# is server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity (content). Project id and dataset are public; the read token is not.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-02

# Viewer token for the private dataset. Server-only — read through
# web/sanity/lib/token.ts, never exposed to the browser.
SANITY_API_READ_TOKEN=

# Sanity Context MCP (intelligent search). Server-only: this is the search
# agent's read path into the dataset and is authenticated with the read token
# above. The document form applies the search config imported from
# studio/context; the base form (no trailing slug) takes the same filter and
# instructions as ?groqFilter= and ?instructions= query params.
# https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/<dataset>/<slug>
SANITY_CONTEXT_MCP_URL=

# OpenCode Zen (the search agent's model), an AI gateway reached through its
# OpenAI-compatible API. Server-only — never prefixed NEXT_PUBLIC_. The browser
# never calls the model; it only ever POSTs to /api/search.
OPENCODE_API_KEY=

# Optional. Defaults to https://opencode.ai/zen/v1 — set this only to point at a
# different OpenAI-compatible gateway.
OPENCODE_BASE_URL=

# Optional. Defaults to nemotron-3-ultra-free. If it is overloaded, the usual
# next try is nemotron-3.5-lightning-free.
#
# Two constraints on what can go here, and both fail confusingly:
#
# 1. The provider speaks /chat/completions and nothing else. Zen routes some
#    model families to /responses or /messages instead, and those cannot be
#    reached from the app at all. Open-weights models are the safest bet.
# 2. Search is an agentic loop, so the model has to actually call the Context
#    MCP's tools and write GROQ. A model that answers straight away without
#    calling anything produces an empty result set, or invented lessons that
#    the route then drops — either way, no results.
#
# This is the first knob to turn if search starts failing. To see what is served:
#   curl.exe -s https://opencode.ai/zen/v1/models
# It needs no API key. Model ids here are unprefixed — `gpt-5.5`, not
# `opencode/gpt-5.5`; the prefixed form is for OpenCode's own TUI config.
OPENCODE_MODEL=

# PostHog (product analytics). The project token is public by design and is the
# only PostHog value the browser needs. Any private PostHog API key stays
# server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- studio/.env ------------------------------------------------------------

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_API_VERSION=2026-09-02
